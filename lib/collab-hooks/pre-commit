#!/usr/bin/env bash
# pre-commit hook installed only in collab worktrees.
# Reads .collab-protect at the worktree root and rejects commits that touch
# any matching path. Hard enforcement — sparring agents can't override the
# rule by ignoring the prompt instruction.
#
# Patterns: gitignore-style globs, one per line, # for comments. Empty lines
# ignored. Examples:
#     src/components/primitives/*.tsx
#     **/Card.tsx
#     src/generated/**
#
# Bypass (operator-side, intentional): COLLAB_PROTECT_BYPASS=1 git commit ...
# Without the env, the commit fails with exit 1 and a clear list of violations.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -z "$REPO_ROOT" ] && exit 0  # not a git repo (shouldn't happen pre-commit)

# ── delegate to the repo's OWN .git/hooks/pre-commit ────────────────────
# The mirror image of the 2026-08-02 failure described just below. Setting
# core.hooksPath makes git ignore .git/hooks entirely, which killed a gate
# that lived there; the same override also means a hook LEGITIMATELY installed
# at .git/hooks/pre-commit never runs in any repo pointing here. Measured
# 2026-08-28: config-gate's shim was live in ~/.openclaw/config (whose
# hooksPath is scripts/git-hooks, and whose _dispatch has delegated since it
# was written) and silently dead in ~/.openclaw/scripts, which points here.
# Of the nine repos on this hooks dir, none had a .git/hooks/pre-commit, so
# this is a no-op for the other eight.
#
# --git-common-dir, NOT --git-dir: in a worktree the latter answers
# .git/worktrees/<name>, which git never consults for hooks. Measured the same
# day with a hook placed in each — only the common-dir one ran. Collab
# worktrees are this directory's primary consumer, so --git-dir would be dead
# in exactly the case that matters most. Recursion is not a risk the way it is
# for _dispatch: --git-common-dir always answers the repo's own .git, never
# this hooks directory.
#
# Called on every path this script ALLOWS and never after it refuses: the
# gates above still decide first, and delegation runs only once they passed.
# git passes a pre-commit hook no arguments, so none are forwarded.
delegate_and_exit() {
  local own
  own="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/pre-commit"
  if [ -x "$own" ]; then
    exec "$own"
  fi
  exit 0
}

# ── secret scan (runs FIRST — a leaked credential outranks everything) ───
# Lives here, not in .git/hooks/pre-commit, because setting core.hooksPath makes
# git ignore .git/hooks ENTIRELY. On 2026-08-02 the secret gate was installed as
# .git/hooks/pre-commit in five repos and was silently dead in the two that
# point here; a planted AWS key committed cleanly. worktree-manager.ts re-points
# hooksPath at this directory for every new collab worktree, so this file is the
# only location the gate survives in.
SECRET_SCAN="$HOME/.openclaw/scripts/secret-scan.py"
# shellcheck source=_hook-python.sh
. "$(dirname "$0")/_hook-python.sh"
if [ -f "$SECRET_SCAN" ]; then
  hook_python "$SECRET_SCAN" --staged --repo "$REPO_ROOT" >&2 || exit 1
else
  echo "pre-commit: $SECRET_SCAN missing — refusing to commit unscanned" >&2
  exit 1
fi

# ── self-recursion guard (runs FIRST, independent of .collab-protect) ────
# Detects the "wrap-and-rename" class bug where a refactor's replace_all
# captures the function's own body. See ~/.openclaw/scripts/check-self-recursion.mjs.
# Bypass: SELF_RECURSION_BYPASS=1 git commit ...
SELF_RECURSION_CHECK="$HOME/.openclaw/scripts/check-self-recursion.mjs"
if [ -z "${SELF_RECURSION_BYPASS:-}" ] && [ -f "$SELF_RECURSION_CHECK" ]; then
  if ! node "$SELF_RECURSION_CHECK" 1>&2; then
    exit 1
  fi
fi

if [ -n "${COLLAB_PROTECT_BYPASS:-}" ]; then
  delegate_and_exit
fi

PROTECT_FILE="$REPO_ROOT/.collab-protect"
[ ! -f "$PROTECT_FILE" ] && delegate_and_exit  # nothing more to enforce

# Build glob list (skip empty + comments)
mapfile -t PATTERNS < <(grep -vE '^\s*(#|$)' "$PROTECT_FILE" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
[ "${#PATTERNS[@]}" -eq 0 ] && delegate_and_exit

# Get staged files (M/A/R/C, not D — we don't block deletions)
STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)
[ -z "$STAGED" ] && delegate_and_exit

# Match each staged file against each pattern via shell pathname matching.
# We use `case` glob match with extglob enabled so ** in patterns works.
shopt -s globstar nullglob extglob 2>/dev/null || true

VIOLATIONS=()
while IFS= read -r f; do
  [ -z "$f" ] && continue
  for p in "${PATTERNS[@]}"; do
    # shellcheck disable=SC2053
    if [[ "$f" == $p ]]; then
      VIOLATIONS+=("$f  ←  matches \`$p\`")
      break
    fi
  done
done <<< "$STAGED"

if [ "${#VIOLATIONS[@]}" -eq 0 ]; then
  delegate_and_exit
fi

echo ""
echo "🔒 collab-protect: blocked commit — files matching .collab-protect:" >&2
for v in "${VIOLATIONS[@]}"; do
  echo "    $v" >&2
done
echo "" >&2
echo "  These paths are explicitly off-limits to collab agents. Options:" >&2
echo "    1. Reword the change to avoid the protected file" >&2
echo "    2. Emit [BLOCKER] in team-say so the operator can lift the restriction" >&2
echo "    3. Operator-side bypass: COLLAB_PROTECT_BYPASS=1 git commit ... (only after explicit human review)" >&2
echo "" >&2
exit 1
