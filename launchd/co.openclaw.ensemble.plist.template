<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>co.openclaw.ensemble</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__ENSEMBLE_ROOT__/bin/ensemble.cjs</string>
    <string>start</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ENSEMBLE_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ENSEMBLE_ROOT</key>
    <string>__ENSEMBLE_ROOT__</string>
    <key>ENSEMBLE_HOST</key>
    <string>__ENSEMBLE_HOST__</string>
    <key>ENSEMBLE_PORT</key>
    <string>__ENSEMBLE_PORT__</string>
    <key>ENSEMBLE_DATA_DIR</key>
    <string>__ENSEMBLE_DATA_DIR__</string>
__OPTIONAL_AUTH_TOKEN__
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd.err.log</string>
</dict>
</plist>
